+/// `cargo run`'ın xtask için ayarladığı ve alt araçları yanıltan değişkenler
+/// (ör. `cargo-machete` `CARGO_PKG_NAME` görünce argümanları yol sanır).
+const CARGO_RUN_VARS: &[&str] = &[
+    "CARGO_MANIFEST_DIR",
+    "CARGO_MANIFEST_PATH",
+    "CARGO_CRATE_NAME",
+    "CARGO_BIN_NAME",
+    "CARGO_PRIMARY_PACKAGE",
+];
